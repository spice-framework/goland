<idea-plugin>
  <id>com.github.stevenbuglione.spice</id>
  <name>Spice</name>
  <vendor url="https://github.com/StevenBuglione/spice">Spice contributors</vendor>

  <description><![CDATA[
    Native GoLand presentation and navigation for valid-Go Spice annotations,
    backed by the shared Spice language server.
  ]]></description>

  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.ultimate</depends>
  <depends>com.intellij.modules.lsp</depends>
  <depends>org.jetbrains.plugins.go</depends>

  <extensions defaultExtensionNs="com.intellij">
    <lang.foldingBuilder
        language="go"
        implementationClass="com.github.stevenbuglione.spice.goland.SpiceFoldingBuilder"
        order="first"/>
    <typedHandler
        implementation="com.github.stevenbuglione.spice.goland.SpiceTypedHandler"/>
    <psi.referenceContributor
        language="go"
        implementation="com.github.stevenbuglione.spice.goland.SpiceAnnotationReferenceContributor"/>
    <completion.contributor
        language="go"
        implementationClass="com.github.stevenbuglione.spice.goland.SpiceCompletionContributor"/>
    <lang.documentationProvider
        language="go"
        implementationClass="com.github.stevenbuglione.spice.goland.SpiceDocumentationProvider"/>
    <platform.backend.documentation.targetProvider
        implementation="com.github.stevenbuglione.spice.goland.SpiceDocumentationTargetProvider"
        order="first"/>
    <platform.backend.documentation.psiTargetProvider
        implementation="com.github.stevenbuglione.spice.goland.SpicePsiDocumentationTargetProvider"
        order="first"/>
    <definitionsScopedSearch
        implementation="com.github.stevenbuglione.spice.goland.SpiceImplementationSearch"/>
    <annotator
        language="go"
        implementationClass="com.github.stevenbuglione.spice.goland.SpiceAnnotationAnnotator"/>
    <codeInsight.lineMarkerProvider
        language="go"
        implementationClass="com.github.stevenbuglione.spice.goland.SpiceAnnotationLineMarkerProvider"/>
    <colorSettingsPage
        implementation="com.github.stevenbuglione.spice.goland.SpiceColorSettingsPage"/>
    <additionalTextAttributes
        scheme="Default"
        file="colorSchemes/SpiceDefault.xml"/>
    <additionalTextAttributes
        scheme="Darcula"
        file="colorSchemes/SpiceDarcula.xml"/>
    <platform.lsp.integrationProvider
        implementation="com.github.stevenbuglione.spice.goland.SpiceLspIntegrationProvider"/>
    <configurationType
        implementation="com.github.stevenbuglione.spice.goland.SpiceApplicationRunConfigurationType"/>
    <runConfigurationProducer
        implementation="com.github.stevenbuglione.spice.goland.SpiceApplicationRunConfigurationProducer"/>
    <stepsBeforeRunProvider
        implementation="com.github.stevenbuglione.spice.goland.SpiceGenerateBeforeRunTaskProvider"/>
    <notificationGroup
        id="Spice"
        displayType="BALLOON"
        isLogByDefault="true"/>
    <toolWindow
        id="Spice"
        anchor="right"
        factoryClass="com.github.stevenbuglione.spice.goland.SpiceHealthToolWindowFactory"/>
  </extensions>

  <extensions defaultExtensionNs="com.goide">
    <runConfigurationExtension
        implementation="com.github.stevenbuglione.spice.goland.SpiceGoRunConfigurationExtension"/>
  </extensions>
</idea-plugin>
