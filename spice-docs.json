{
  "$schema": "https://spiceframework.dev/schemas/spice-docs.schema.json",
  "schema": 1,
  "product": {
    "id": "goland",
    "title": "Spice for GoLand",
    "family": "developer-tools",
    "summary": "A GoLand plugin that presents canonical Spice declarations with semantic editor assistance while preserving valid Go.",
    "maturity": "preview",
    "audience": [
      "application-developer",
      "evaluator"
    ]
  },
  "content": [
    {
      "source": "README.md",
      "route": "index",
      "kind": "how-to",
      "order": 0,
      "search": true
    },
    {
      "source": "docs/**/*.md",
      "routeFrom": "docs",
      "order": 10,
      "search": true
    }
  ]
}
